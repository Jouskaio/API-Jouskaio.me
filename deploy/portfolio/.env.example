# Copy to /home/user/Documents/api.jouskaio.me/.env on the host (never commit the real one).
# Generate the token with: openssl rand -hex 32   (minimum 32 characters)
JOUSKAIO_API_TOKEN=
JOUSKAIO_ENABLED_MODULES=news
JOUSKAIO_LOG_LEVEL=INFO
JOUSKAIO_ENABLE_DOCS=false

# Owner of the ./data folder (output of `id -u` and `id -g`)
PUID=1000
PGID=1000
