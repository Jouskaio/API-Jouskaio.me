# --- Core ------------------------------------------------------------------
# Generate with: openssl rand -hex 32   (minimum 32 characters, required)
JOUSKAIO_API_TOKEN=
JOUSKAIO_ENABLED_MODULES=notes_sync
JOUSKAIO_LOG_LEVEL=INFO
# Swagger UI on /api/v1/docs. Keep false unless you are developing.
JOUSKAIO_ENABLE_DOCS=false

# --- notes_sync module (paths INSIDE the container; defaults shown) ---------
# JOUSKAIO_NOTES_SYNC_INBOX_DIR=/inbox
# JOUSKAIO_NOTES_SYNC_VAULT_DIR=/vault
# JOUSKAIO_NOTES_SYNC_NOTES_SUBDIR=Notability
# JOUSKAIO_NOTES_SYNC_ATTACHMENTS_SUBDIR=Attachments/Notability
# JOUSKAIO_NOTES_SYNC_STATE_FILE=/data/notes_sync_state.json
# JOUSKAIO_NOTES_SYNC_MIN_FILE_AGE_SECONDS=10
# JOUSKAIO_NOTES_SYNC_EXTRACT_PDF_TEXT=true

# --- Handwriting OCR (optional, local, CPU) ------------------------------------
# Needs the image built with WITH_OCR=true (or `uv sync --extra ocr`) and the model:
#   scripts/fetch-ocr-model.sh      -> $DATA_PATH/models, i.e. /data/models in the container
# JOUSKAIO_NOTES_SYNC_OCR_ENGINE=kraken
# JOUSKAIO_NOTES_SYNC_OCR_MODEL=/data/models/McCATMuS_nfd_nofix_V1.mlmodel
# JOUSKAIO_NOTES_SYNC_OCR_DPI=200          # lower = faster, less accurate
# JOUSKAIO_NOTES_SYNC_OCR_MAX_PAGES=30     # per note
# JOUSKAIO_NOTES_SYNC_OCR_THREADS=1        # keep 1 on a small VM

# --- docker compose only (host paths, read by compose for the volumes) -------
NOTES_INBOX_PATH=/volume1/notability-inbox
OBSIDIAN_VAULT_PATH=/volume1/obsidian/MyVault
DATA_PATH=./data
# PUID=1026
# PGID=100
# WITH_OCR=true                        # build the image with handwriting OCR

# --- Local development without Docker (run from the repo root) ---------------
# JOUSKAIO_NOTES_SYNC_INBOX_DIR=./dev/inbox
# JOUSKAIO_NOTES_SYNC_VAULT_DIR=./dev/vault
# JOUSKAIO_NOTES_SYNC_STATE_FILE=./dev/state.json
# JOUSKAIO_NOTES_SYNC_OCR_MODEL=./data/models/McCATMuS_nfd_nofix_V1.mlmodel
